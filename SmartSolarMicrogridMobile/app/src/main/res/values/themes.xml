<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ════════════════════════════════════════
         Main App Theme  – Material 3 green brand
         ════════════════════════════════════════ -->
    <style name="Theme.SmartSolar" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <!-- Secondary / accent -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <!-- Surfaces -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>

        <!-- Error -->
        <item name="colorError">@color/error</item>
        <item name="colorErrorContainer">@color/error_container</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>

        <!-- Typography -->
        <item name="android:fontFamily">sans-serif</item>

        <!-- Shapes -->
        <item name="shapeAppearanceSmallComponent">@style/Shape.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/Shape.Large</item>
    </style>

    <!-- ════ Shapes (More elegant rounding) ════ -->
    <style name="Shape.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">6dp</item>
    </style>
    <style name="Shape.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">10dp</item>
    </style>
    <style name="Shape.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">14dp</item>
    </style>

    <!-- ════ Splash / Launch Screen ════ -->
    <style name="Theme.SmartSolar.Splash" parent="Theme.SmartSolar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
    </style>

    <!-- ════ TextInputLayout – outlined ════ -->
    <style name="Widget.SmartSolar.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary_container</item>
        <item name="hintTextColor">@color/on_surface_variant</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
    </style>

    <!-- ════ Primary filled button ════ -->
    <style name="Widget.SmartSolar.Button" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- ════ Outlined / secondary button ════ -->
    <style name="Widget.SmartSolar.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">@color/primary_container</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <!-- ════ Card ════ -->
    <style name="Widget.SmartSolar.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">6dp</item>
        <item name="contentPadding">0dp</item>
    </style>

    <!-- ════ Dashboard action button ════ -->
    <style name="Widget.SmartSolar.ActionButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">18dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="iconGravity">start</item>
        <item name="iconPadding">16dp</item>
    </style>

</resources>
